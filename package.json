{
	"name": "schematic",
	"version": "1.0.0",
	"description": "A Prisma generator",
	"main": "dist/index.js",
	"bin": {
		"schematic": "dist/index.js"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"prepack": "pnpm build",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"lint": "eslint src/**/*.ts",
		"lint:fix": "eslint src/**/*.ts --fix",
		"format": "prettier --write \"src/**/*.ts\"",
		"format:check": "prettier --check \"src/**/*.ts\"",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"prisma",
		"prisma-generator",
		"generator"
	],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@prisma/client": "7.10.0",
		"@prisma/generator-helper": "^7.8.0",
		"@prisma/internals": "^7.8.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^26.0.1",
		"@typescript-eslint/eslint-plugin": "^8.62.1",
		"@typescript-eslint/parser": "^8.62.1",
		"@vitest/ui": "^4.1.9",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"prettier": "^3.9.4",
		"prisma": "7.8.0",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	},
	"engines": {
		"node": ">=18.0.0"
	}
}
